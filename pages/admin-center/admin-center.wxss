.admin-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: var(--bg-page);
}

.admin-loading {
  padding: 160rpx 24rpx;
  text-align: center;
  color: var(--text-secondary);
}

.admin-summary {
  padding: 28rpx 4rpx 32rpx;
}

.admin-summary-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
}

.admin-summary-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.admin-group {
  margin-bottom: 32rpx;
}

.admin-group-title {
  display: block;
  margin: 0 4rpx 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.admin-list {
  overflow: hidden;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.admin-item {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.admin-item:last-child {
  border-bottom: 0;
}

.admin-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: var(--radius-sm);
  background: #eff6ff;
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.admin-item-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
}

.admin-arrow {
  color: var(--text-muted);
  font-size: 42rpx;
  line-height: 1;
}
