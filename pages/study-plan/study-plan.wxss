/* pages/study-plan/study-plan.wxss */

.plan-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 32rpx 180rpx;
}

.plan-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.plan-course-header {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 32rpx;
  flex: 1;
}

.plan-course-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.plan-course-info {
  flex: 1;
  min-width: 0;
}

.plan-course-name {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.plan-course-meta {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 12rpx;
}

.plan-prog-bar {
  height: 6rpx;
  background: var(--border);
  border-radius: 100rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
}

.plan-prog-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 100rpx;
}

.plan-prog-text {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
}

.plan-deadline {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border);
  margin-bottom: 8rpx;
}

.plan-deadline-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.plan-deadline-val {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--border);
}

.plan-row-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.plan-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}

.picker-arrow {
  font-size: 24rpx;
}

.plan-stats {
  display: flex;
  gap: 24rpx;
  margin: 24rpx 0;
}

.plan-stat-item {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
}

.plan-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  display: block;
}

.plan-stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.plan-action-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.plan-action-btn {
  flex: 1;
}

.ad-wrap {
  min-height: 120rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
}
