/* pages/calendar/calendar.wxss */

.cal-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 32rpx 160rpx;
}

.cal-header {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.cal-nav {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.cal-nav-btn {
  font-size: 48rpx;
  color: var(--primary);
  padding: 0 24rpx;
}

.cal-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.cal-header-right {
  margin-left: auto;
  color: var(--text-muted);
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.cal-weekday {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 8rpx 0;
}

.cal-weekday.weekend {
  color: var(--danger);
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
}

.cal-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: var(--radius-sm);
}

.cal-day-num {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

.cal-day.other-month .cal-day-num {
  color: var(--text-muted);
  opacity: 0.4;
}

.cal-day.today {
  background: var(--primary);
  border-radius: var(--radius-md);
}

.cal-day.today .cal-day-num {
  color: #fff;
  font-weight: 700;
}

.cal-day.checked .cal-day-num {
  color: var(--primary);
  font-weight: 700;
}

.cal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--secondary);
  margin-top: 4rpx;
}

.cal-day.today .cal-dot {
  background: #fff;
}

/* ===== 学习记录 ===== */
.section {
  margin-bottom: 24rpx;
}

.record-list {}

.record-item {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.record-item:last-child {
  border-bottom: none;
}

.record-time {
  font-size: 24rpx;
  color: var(--text-muted);
  white-space: nowrap;
  min-width: 80rpx;
}

.record-main {
  flex: 1;
}

.record-bank {
  display: block;
  font-size: 22rpx;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.record-desc {
  font-size: 26rpx;
  color: var(--text-primary);
  flex: 1;
  display: block;
}

.record-status {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ===== 待完成计划 ===== */
.plan-items {}

.plan-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.plan-item:last-child {
  border-bottom: none;
}

.plan-item.done {
  opacity: 0.5;
}

.plan-item-info {
  flex: 1;
}

.plan-item-title {
  font-size: 26rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.strikethrough {
  text-decoration: line-through;
}

.plan-item-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.plan-item-tag {
  font-size: 22rpx;
  color: #B45309;
  background: #FEF3C7;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
}

.plan-item-tag--done {
  color: #047857;
  background: #D1FAE5;
}
