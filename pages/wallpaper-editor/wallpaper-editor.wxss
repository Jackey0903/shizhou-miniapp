.we-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  box-sizing: border-box;
}

.we-preview {
  margin-bottom: 24rpx;
  overflow: hidden;
}

.we-preview-wrap {
  position: relative;
  aspect-ratio: 9 / 16;
  border-radius: 32rpx;
  overflow: hidden;
}

.we-bg {
  width: 100%;
  height: 100%;
}

.we-overlay {
  position: absolute;
  inset: 0;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: rgba(15, 23, 42, 0.08);
}

.we-title {
  font-size: 48rpx;
  line-height: 1.5;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.32);
}

.we-question-box {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
}

.we-question-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.we-question-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #fff;
  font-weight: 600;
}

.we-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.we-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.we-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--border);
  background: #fff;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.7;
}

.we-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.we-switch-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.we-picker {
  min-height: 96rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--border);
  background: #fff;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-primary);
}

.we-tip {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.we-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.we-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750px;
  height: 1334px;
}

.we-share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1080px;
  height: 1080px;
}
