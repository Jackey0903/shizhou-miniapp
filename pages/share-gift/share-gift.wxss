.sg-page { min-height:100vh; background:var(--bg-page); padding:32rpx; }
.sg-hero { text-align:center; padding:56rpx 32rpx; }
.sg-icon { font-size:120rpx; display:block; margin-bottom:24rpx; }
.sg-title { font-size:40rpx; font-weight:800; display:block; margin-bottom:16rpx; }
.sg-desc { font-size:31rpx; color:var(--text-secondary); display:block; line-height:1.65; white-space: nowrap; }
.sg-desc-sub { margin-top: 8rpx; }
.sg-steps { display:flex; flex-direction:column; gap:24rpx; margin:32rpx 0; }
.sg-step { display:flex; align-items:center; gap:24rpx; padding:24rpx; background:#fff; border-radius:var(--radius-lg); }
.sg-step-num { width:64rpx; height:64rpx; border-radius:50%; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:28rpx; flex-shrink:0; }
.sg-step-text { font-size:28rpx; color:var(--text-primary); line-height:1.6; }
.sg-service { background:#fff; border-radius:var(--radius-lg); padding:32rpx; margin-bottom:32rpx; text-align:center; }
.sg-service-label { display:block; font-size:24rpx; color:var(--text-secondary); margin-bottom:12rpx; }
.sg-service-title { display:block; font-size:34rpx; font-weight:800; color:var(--text-primary); margin-bottom:24rpx; }
.sg-qrcode { width:420rpx; height:420rpx; margin:0 auto 20rpx; border-radius:24rpx; background:#f7f9fc; }
.sg-qrcode-error { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; color:var(--text-muted); font-size:24rpx; }
.sg-service-tip { display:block; font-size:24rpx; line-height:1.7; color:var(--text-muted); }
