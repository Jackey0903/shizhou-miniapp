.access-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: var(--bg-page);
}

.access-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.access-input {
  flex: 1;
  min-width: 0;
  min-height: 84rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
}

.search-button {
  width: 150rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-md);
  background: var(--primary);
  color: #fff;
  font-size: 27rpx;
}

.search-button::after {
  border: 0;
}

.user-list {
  margin-bottom: 24rpx;
}

.user-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 132rpx;
  padding: 22rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
  background: #fff;
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
}

.user-item--selected {
  border-color: var(--primary);
  background: #eff6ff;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name,
.user-phone,
.user-meta {
  display: block;
}

.user-name {
  font-size: 28rpx;
  font-weight: 700;
}

.user-phone,
.user-meta {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.user-check {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.selected-label {
  display: block;
  margin-bottom: 16rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.access-picker,
.access-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 22rpx;
  background: #f8fafc;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
}

.access-picker {
  min-height: 96rpx;
}

.picker-detail {
  display: block;
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.access-textarea {
  min-height: 150rpx;
}

.log-section {
  margin-top: 32rpx;
}

.log-title {
  display: block;
  margin: 0 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.log-item {
  padding: 22rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: var(--radius-md);
}

.log-name,
.log-meta,
.log-reason {
  display: block;
}

.log-name {
  font-size: 27rpx;
  font-weight: 700;
}

.log-meta,
.log-reason {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}
