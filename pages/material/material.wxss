.mat-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  box-sizing: border-box;
}

.mat-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.mat-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
}

.mat-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.mat-coins {
  min-width: 132rpx;
  text-align: center;
  padding: 20rpx 16rpx;
  border-radius: 24rpx;
  background: #eff6ff;
}

.mat-coins-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary);
}

.mat-coins-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.mat-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mat-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: #f3f4f6;
}

.mat-tab--active {
  color: #fff;
  background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
  font-weight: 700;
}

.mat-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
}

.mat-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.mat-cover {
  width: 84rpx;
  height: 84rpx;
  display: block;
}

.mat-info { flex: 1; min-width: 0; }
.mat-name { display: block; font-size: 30rpx; font-weight: 700; }
.mat-desc { display: block; margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: var(--text-secondary); }
.mat-meta-row { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; }
.mat-meta, .mat-cost { font-size: 22rpx; color: var(--text-muted); }
.mat-cost { color: #ea580c; font-weight: 700; }
.mat-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}
.mat-btn {
  min-width: 120rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  border: 0;
}
.mat-btn--ghost {
  background: #eef2ff;
  color: var(--primary);
}
