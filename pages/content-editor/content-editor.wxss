.content-editor-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: var(--bg-page); }
.editor-loading { padding: 80rpx 0; text-align: center; color: var(--text-secondary); font-size: 28rpx; }
.editor-card { padding: 28rpx; }
.editor-heading { margin-bottom: 24rpx; }
.editor-title, .editor-sub, .editor-label, .editor-file-state { display: block; }
.editor-title { font-size: 34rpx; font-weight: 800; color: var(--text-primary); }
.editor-sub { margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; color: var(--text-secondary); }
.editor-field { margin-top: 20rpx; }
.editor-label { margin-bottom: 10rpx; font-size: 25rpx; font-weight: 700; color: var(--text-primary); }
.editor-input, .editor-picker, .editor-textarea { width: 100%; min-height: 84rpx; box-sizing: border-box; padding: 18rpx 20rpx; border: 2rpx solid var(--border); border-radius: var(--radius-sm); background: #f8fafc; color: var(--text-primary); font-size: 27rpx; }
.editor-picker { display: flex; align-items: center; }
.editor-textarea { min-height: 150rpx; }
.editor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.editor-preview { width: 100%; height: 420rpx; border-radius: var(--radius-sm); background: #f1f5f9; }
.editor-file-btn { width: 100%; margin-top: 22rpx; border: 0; border-radius: var(--radius-sm); background: #eff6ff; color: var(--primary); font-size: 27rpx; }
.editor-file-btn::after { border: 0; }
.editor-file-state { margin: 12rpx 0 24rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; word-break: break-all; }
