<view class="content-editor-page">
  <view class="editor-loading" wx:if="{{loading}}">正在加载内容...</view>
  <view class="editor-card card" wx:else>
    <view class="editor-heading">
      <text class="editor-title">{{targetLabel}}</text>
      <text class="editor-sub">保存后立即同步用户端。排序数字越小越靠前。</text>
    </view>

    <block wx:if="{{target === 'audios'}}">
      <view class="editor-field">
        <text class="editor-label">音频标题</text>
        <input class="editor-input" value="{{form.title}}" data-field="title" bindinput="onInput" maxlength="200"/>
      </view>
      <view class="editor-field">
        <text class="editor-label">所属模块</text>
        <input class="editor-input" value="{{form.category}}" data-field="category" bindinput="onInput" maxlength="50"/>
      </view>
      <view class="editor-field editor-grid">
        <view>
          <text class="editor-label">标签</text>
          <input class="editor-input" value="{{form.type}}" data-field="type" bindinput="onInput" maxlength="50"/>
        </view>
        <view>
          <text class="editor-label">时长说明</text>
          <input class="editor-input" value="{{form.duration}}" data-field="duration" bindinput="onInput" maxlength="50"/>
        </view>
      </view>
    </block>

    <block wx:if="{{target === 'materials'}}">
      <view class="editor-field">
        <text class="editor-label">资料名称</text>
        <input class="editor-input" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="200"/>
      </view>
      <view class="editor-field">
        <text class="editor-label">资料类型</text>
        <picker range="{{materialTypes}}" range-key="label" value="{{materialTypeIndex}}" bindchange="onMaterialTypeChange">
          <view class="editor-picker">{{materialTypes[materialTypeIndex].label}}</view>
        </picker>
      </view>
      <view class="editor-field">
        <text class="editor-label">资料说明</text>
        <textarea class="editor-textarea" value="{{form.description}}" data-field="description" bindinput="onInput" maxlength="2000" auto-height/>
      </view>
      <view class="editor-field">
        <text class="editor-label">HTTPS 外链（可选）</text>
        <input class="editor-input" placeholder="替换为 HTTPS 外部链接" value="{{form.linkUrl}}" data-field="linkUrl" bindinput="onInput" maxlength="2000"/>
      </view>
      <button class="editor-file-btn" bindtap="chooseCover" loading="{{replacing}}" wx:if="{{form.type !== 'image'}}">替换封面（可选）</button>
    </block>

    <block wx:if="{{target === 'wallpapers'}}">
      <view class="editor-field">
        <text class="editor-label">壁纸标题</text>
        <input class="editor-input" value="{{form.title}}" data-field="title" bindinput="onInput" maxlength="200"/>
      </view>
      <image class="editor-preview" wx:if="{{form.fileId || form.imageUrl}}" src="{{form.fileId || form.imageUrl}}" mode="aspectFill"/>
    </block>

    <view class="editor-field">
      <text class="editor-label">展示顺序</text>
      <input class="editor-input" type="number" placeholder="数字越小越靠前" value="{{form.sort}}" data-field="sort" bindinput="onInput"/>
    </view>
    <button class="editor-file-btn" bindtap="chooseFile" loading="{{replacing}}">{{fileLabel}}</button>
    <text class="editor-file-state" wx:if="{{replacementName}}">{{replacementName}}</text>
    <text class="editor-file-state" wx:else>已关联文件：{{form.fileId || form.fileUrl || form.linkUrl || '未设置'}}</text>
    <button class="btn btn-primary btn-full" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存修改</button>
  </view>
</view>
