.doc-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.doc-card {
  background: #fff;
  border-radius: var(--radius-xl);
  padding: 32rpx;
  box-shadow: var(--shadow);
}

.doc-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.doc-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.doc-section {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.doc-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-secondary);
}
