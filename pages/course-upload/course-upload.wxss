.cu-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  box-sizing: border-box;
}

.cu-card {
  padding: 28rpx;
}

.cu-head {
  margin-bottom: 24rpx;
}

.cu-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.cu-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.cu-field {
  margin-bottom: 22rpx;
}

.cu-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cu-input,
.cu-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  background: #fff;
  min-height: 96rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.cu-textarea {
  min-height: 220rpx;
}

.cu-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 8rpx;
  color: var(--text-primary);
  font-size: 28rpx;
}
