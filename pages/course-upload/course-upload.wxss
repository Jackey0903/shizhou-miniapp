.cu-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: var(--bg-page);
}

.cu-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 4rpx 28rpx;
}

.cu-title,
.cu-sub,
.cu-subject-name,
.cu-meta,
.cu-bank-name {
  display: block;
}

.cu-title {
  font-size: 38rpx;
  font-weight: 800;
}

.cu-sub {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.cu-toolbar-actions,
.cu-inline-actions,
.cu-form-row,
.cu-options {
  display: flex;
  gap: 12rpx;
}

.cu-action,
.cu-mini,
.cu-add-bank {
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
}

.cu-action {
  height: 72rpx;
  line-height: 72rpx;
  white-space: nowrap;
}

.cu-action--secondary {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.cu-action::after,
.cu-mini::after,
.cu-add-bank::after {
  border: 0;
}

.cu-form {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.cu-form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cu-form-title {
  font-size: 31rpx;
  font-weight: 800;
}

.cu-close {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.cu-input,
.cu-textarea,
.cu-picker {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  background: #f8fafc;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 27rpx;
}

.cu-textarea {
  min-height: 150rpx;
}

.cu-picker {
  display: flex;
  align-items: center;
}

.cu-input--half {
  flex: 1;
  min-width: 0;
}

.cu-check {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
}

.cu-options {
  margin-bottom: 12rpx;
}

.cu-subject {
  margin-bottom: 20rpx;
  overflow: hidden;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.cu-subject-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.cu-subject-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.cu-color {
  width: 12rpx;
  height: 72rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.cu-subject-name,
.cu-bank-name {
  font-size: 28rpx;
  font-weight: 700;
}

.cu-meta {
  margin-top: 5rpx;
  color: var(--text-secondary);
  font-size: 21rpx;
}

.cu-bank {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 24rpx 18rpx 48rpx;
  border-bottom: 1rpx solid var(--border);
}

.cu-bank-main {
  flex: 1;
  min-width: 0;
}

.cu-mini {
  min-width: 88rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 14rpx;
  background: #eff6ff;
  color: var(--primary);
  font-size: 22rpx;
}

.cu-mini--danger {
  background: #fef2f2;
  color: var(--danger);
}

.cu-mini--success {
  background: #ecfdf5;
  color: #047857;
}

.cu-add-bank {
  width: auto;
  height: 68rpx;
  line-height: 68rpx;
  margin: 16rpx 24rpx;
  background: #f8fafc;
  color: var(--primary);
}
