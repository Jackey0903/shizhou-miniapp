<view class="cu-page">
  <view class="empty" wx:if="{{loading}}">
    <text class="empty-text">正在加载模块与题库...</text>
  </view>

  <view class="empty" wx:elif="{{!hasAccess}}">
    <text class="empty-text">当前账号没有管理员权限</text>
  </view>

  <block wx:else>
    <view class="cu-toolbar">
      <view class="cu-toolbar-text">
        <text class="cu-title">模块与题库</text>
        <text class="cu-sub">下线只隐藏内容，不删除题目和学习记录。</text>
      </view>
      <view class="cu-toolbar-actions">
        <view class="cu-action cu-action--secondary" hover-class="op-hover" bindtap="openSubjectForm">新增模块</view>
        <view class="cu-action {{subjectOptions.length ? '' : 'is-disabled'}}" hover-class="op-hover" bindtap="openBankForm">新增题库</view>
      </view>
    </view>

    <view class="cu-form" wx:if="{{showSubjectForm}}">
      <view class="cu-form-head">
        <text class="cu-form-title">{{subjectForm.id ? '编辑模块' : '新增模块'}}</text>
        <text class="cu-close" bindtap="closeForms">关闭</text>
      </view>
      <input class="cu-input" placeholder="模块名称，如 常识、申论、面试" value="{{subjectForm.name}}" data-field="name" bindinput="onSubjectInput"/>
      <textarea class="cu-textarea" placeholder="模块说明（可选）" value="{{subjectForm.description}}" data-field="description" bindinput="onSubjectInput" maxlength="300"/>
      <view class="cu-form-row">
        <input class="cu-input cu-input--half" type="number" placeholder="排序数字，越小越靠前" value="{{subjectForm.sort}}" data-field="sort" bindinput="onSubjectInput"/>
        <input class="cu-input cu-input--half" placeholder="主题色，如 #2563EB" value="{{subjectForm.color}}" data-field="color" bindinput="onSubjectInput"/>
      </view>
      <checkbox-group bindchange="onSubjectEnabledChange">
        <label class="cu-check"><checkbox value="1" checked="{{subjectForm.enabled}}" color="#2563EB"/>保存后立即上线</label>
      </checkbox-group>
      <button class="btn btn-primary btn-full" loading="{{saving}}" bindtap="saveSubject">保存模块</button>
    </view>

    <view class="cu-form" wx:if="{{showBankForm}}">
      <view class="cu-form-head">
        <text class="cu-form-title">{{bankForm.id ? '编辑题库' : '新增题库'}}</text>
        <text class="cu-close" bindtap="closeForms">关闭</text>
      </view>
      <picker range="{{subjectOptions}}" range-key="name" value="{{subjectIndex}}" bindchange="onSubjectChange">
        <view class="cu-picker">所属模块：{{subjectOptions[subjectIndex].name}}</view>
      </picker>
      <input class="cu-input" placeholder="题库名称" value="{{bankForm.name}}" data-field="name" bindinput="onBankInput"/>
      <input class="cu-input" placeholder="题库标签，如 基础题库 / 高频真题" value="{{bankForm.series}}" data-field="series" bindinput="onBankInput"/>
      <textarea class="cu-textarea" placeholder="题库说明（可选）" value="{{bankForm.description}}" data-field="description" bindinput="onBankInput" maxlength="500"/>
      <input class="cu-input" type="number" placeholder="排序数字，越小越靠前" value="{{bankForm.sort}}" data-field="sort" bindinput="onBankInput"/>
      <view class="cu-options">
        <checkbox-group bindchange="onLockChange">
          <label class="cu-check"><checkbox value="1" checked="{{bankForm.isLocked}}" color="#2563EB"/>仅VIP可用</label>
        </checkbox-group>
        <checkbox-group bindchange="onBankEnabledChange">
          <label class="cu-check"><checkbox value="1" checked="{{bankForm.enabled}}" color="#2563EB"/>保存后立即上线</label>
        </checkbox-group>
      </view>
      <button class="btn btn-primary btn-full" loading="{{saving}}" bindtap="saveBank">保存题库</button>
    </view>

    <view class="cu-list">
      <view class="cu-subject" wx:for="{{tree}}" wx:key="_id" wx:for-item="subject">
        <view class="cu-subject-head">
          <view class="cu-subject-main">
            <view class="cu-color" style="background: {{subject.color || '#2563EB'}}"></view>
            <view class="cu-subject-text">
              <text class="cu-subject-name">{{subject.name}}</text>
              <text class="cu-meta">{{subject.banks.length}}个题库 · 排序{{subject.sort || 0}} · {{subject.enabled ? '已上线' : '已下线'}}</text>
            </view>
          </view>
          <view class="cu-inline-actions" wx:if="{{!subject.virtual}}">
            <view class="cu-mini" hover-class="op-hover" data-id="{{subject._id}}" bindtap="openSubjectForm">编辑</view>
            <view class="cu-mini {{subject.enabled ? 'cu-mini--danger' : 'cu-mini--success'}}" hover-class="op-hover" data-id="{{subject._id}}" data-enabled="{{subject.enabled}}" bindtap="toggleSubject">{{subject.enabled ? '下线' : '上线'}}</view>
          </view>
        </view>

        <view class="cu-bank" wx:for="{{subject.banks}}" wx:key="_id" wx:for-item="bank">
          <view class="cu-bank-main">
            <text class="cu-bank-name">{{bank.name}}</text>
            <text class="cu-meta">{{bank.totalCount || 0}}题 · {{bank.series || '基础题库'}} · {{bank.isLocked ? 'VIP' : '公开'}} · {{bank.enabled ? '已上线' : '已下线'}}</text>
          </view>
          <view class="cu-inline-actions">
            <view class="cu-mini" hover-class="op-hover" data-id="{{bank._id}}" bindtap="openBankForm">编辑</view>
            <view class="cu-mini {{bank.enabled ? 'cu-mini--danger' : 'cu-mini--success'}}" hover-class="op-hover" data-id="{{bank._id}}" data-enabled="{{bank.enabled}}" bindtap="toggleBank">{{bank.enabled ? '下线' : '上线'}}</view>
          </view>
        </view>

        <view class="cu-add-bank" hover-class="op-hover" data-subjectid="{{subject._id}}" bindtap="openBankForm" wx:if="{{!subject.virtual}}">在此模块新增题库</view>
      </view>
    </view>
  </block>
</view>
