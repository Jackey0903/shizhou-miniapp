.home-container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 120rpx;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.header-slogan {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-secondary);
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.header-icon {
  position: relative;
}

.header-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: var(--danger);
  color: #fff;
  font-size: 18rpx;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx;
}

.header-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
}

.section {
  padding: 30rpx 24rpx;
  margin-bottom: 8rpx;
  background: #fff;
  margin-top: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--text-muted);
}

.course-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.category-card {
  position: relative;
  min-height: 260rpx;
  padding: 20rpx 16rpx 16rpx;
  border-radius: var(--radius-xl);
  background: #F8F8FC;
  border: 2rpx solid #E5E7EB;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: stretch;
  text-align: left;
  overflow: hidden;
}

.category-main {
  width: 100%;
}

.category-name {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #111111;
  line-height: 1.15;
  text-align: left;
  margin-bottom: 14rpx;
  padding-left: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 100%;
}

.preview-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  gap: 8rpx;
  min-width: 0;
}

.preview-item-name {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.28;
  text-align: left;
  white-space: normal;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.preview-item-count {
  flex-shrink: 0;
  min-width: 42rpx;
  text-align: right;
  font-size: 20rpx;
  font-weight: 700;
  margin-left: 0;
  white-space: nowrap;
  line-height: 1.28;
}

.category-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.category-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  opacity: 0.8;
}

.category-lock {
  position: absolute;
  right: 22rpx;
  bottom: 20rpx;
  font-size: 28rpx;
}

.skeleton-line {
  background: linear-gradient(90deg, #F3F4F6 25%, #E5E7EB 50%, #F3F4F6 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: var(--radius-md);
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28rpx 20rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.tool-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.tool-icon--blue { background: #EFF6FF; }
.tool-icon--red { background: #FEF2F2; }
.tool-icon--orange { background: #FFF7ED; }
.tool-icon--purple { background: #F5F3FF; }
.tool-icon--green { background: #ECFDF5; }
.tool-icon--teal { background: #F0FDFA; }
.tool-icon--pink { background: #FDF2F8; }
.tool-icon--yellow { background: #FEF9C3; }
.tool-icon--indigo { background: #EEF2FF; }

.tool-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}
