<view class="role-page">
  <view class="role-loading" wx:if="{{loading}}">正在核验最高管理员权限...</view>

  <block wx:elif="{{authorized}}">
    <view class="role-note">
      <text class="role-note-title">用户与管理员</text>
      <text class="role-note-text">仅最高管理员可查看全部用户、授予或撤销管理员，以及移交最高权限。</text>
    </view>

    <view class="role-search">
      <view class="role-search-row">
        <input class="role-input" placeholder="手机号、昵称或用户ID" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="search" confirm-type="search"/>
        <button class="role-search-button" loading="{{searching}}" bindtap="search">搜索</button>
      </view>
      <view class="role-search-meta">
        <text class="role-tip">微信号无法被小程序读取，请优先使用绑定手机号。</text>
        <button class="role-clear-button" wx:if="{{searchMode}}" bindtap="clearSearch">清除搜索</button>
      </view>
    </view>

    <view class="role-tabs">
      <button class="role-tab {{activeTab === 'users' ? 'role-tab--active' : ''}}" data-tab="users" bindtap="switchTab">
        全部用户 <text class="role-tab-count">{{userTotal}}</text>
      </button>
      <button class="role-tab {{activeTab === 'administrators' ? 'role-tab--active' : ''}}" data-tab="administrators" bindtap="switchTab">
        管理员 <text class="role-tab-count">{{administrators.length}}</text>
      </button>
    </view>

    <block wx:if="{{activeTab === 'users'}}">
      <view class="role-list-header">
        <text class="role-section-title">{{searchMode ? '搜索结果' : '全部用户'}}</text>
        <text class="role-list-count">{{searchMode ? searchResultCount : userTotal}} 人</text>
      </view>

      <view
        class="result-card {{selectedUser && selectedUser._id === item._id ? 'result-card--selected' : ''}}"
        wx:for="{{users}}"
        wx:key="_id"
        data-id="{{item._id}}"
        data-source="users"
        bindtap="selectUser"
      >
        <image class="role-avatar" src="{{item.avatarUrl || '/assets/images/default-avatar.webp'}}" mode="aspectFill"/>
        <view class="role-user-main">
          <text class="role-user-name">{{item.nickName}}</text>
          <text class="role-user-hint">{{item.identityHint}}</text>
          <text class="role-user-time">{{item.lastActiveLabel}}</text>
        </view>
        <text class="role-badge {{item.isSuperAdmin ? 'role-badge--owner' : (item.isAdmin ? 'role-badge--admin' : '')}}">{{item.roleLabel}}</text>
      </view>

      <view class="role-empty" wx:if="{{!loadingUsers && !users.length}}">
        <text class="role-empty-title">暂无用户</text>
        <text class="role-empty-text">用户登录小程序后会显示在这里。</text>
      </view>
      <button class="role-load-more" wx:if="{{hasMore && !searchMode}}" loading="{{loadingUsers}}" bindtap="loadMore">加载更多</button>
      <view class="role-list-loading" wx:if="{{loadingUsers && !users.length}}">正在加载用户...</view>
    </block>

    <block wx:else>
      <view class="role-list-header">
        <text class="role-section-title">当前管理员</text>
        <text class="role-list-count">{{administrators.length}} 人</text>
      </view>

      <view
        class="result-card {{selectedUser && selectedUser._id === item._id ? 'result-card--selected' : ''}}"
        wx:for="{{administrators}}"
        wx:key="_id"
        data-id="{{item._id}}"
        data-source="administrators"
        bindtap="selectUser"
      >
        <image class="role-avatar" src="{{item.avatarUrl || '/assets/images/default-avatar.webp'}}" mode="aspectFill"/>
        <view class="role-user-main">
          <text class="role-user-name">{{item.nickName}}</text>
          <text class="role-user-hint">{{item.identityHint}}</text>
          <text class="role-user-time">{{item.lastActiveLabel}}</text>
        </view>
        <text class="role-badge {{item.isSuperAdmin ? 'role-badge--owner' : 'role-badge--admin'}}">{{item.roleLabel}}</text>
      </view>
    </block>

    <view class="role-action-bar" wx:if="{{selectedUser}}">
      <view class="role-action-user">
        <text class="role-action-name">{{selectedUser.nickName}}</text>
        <text class="role-action-role">{{selectedUser.roleLabel}}</text>
      </view>
      <text class="role-owner-note" wx:if="{{selectedUser.isSuperAdmin}}">最高管理员权限不可在此撤销</text>
      <view class="role-action-buttons" wx:else>
        <button
          wx:if="{{!selectedUser.isAdmin}}"
          class="role-button role-button--primary"
          data-enabled="true"
          loading="{{operating}}"
          bindtap="setAdmin"
        >设为管理员</button>
        <button
          wx:else
          class="role-button role-button--danger"
          data-enabled="false"
          loading="{{operating}}"
          bindtap="setAdmin"
        >取消管理员</button>
        <button class="role-button" loading="{{operating}}" bindtap="transferSuperAdmin">移交最高权限</button>
      </view>
    </view>
  </block>
</view>
