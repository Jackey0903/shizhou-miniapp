.ae-page { min-height: 100vh; background: var(--bg-page); padding: 24rpx; box-sizing: border-box; }
.ae-hero-title { display: block; font-size: 36rpx; font-weight: 800; }
.ae-hero-sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; }
.ae-tabs { white-space: nowrap; margin: 20rpx 0; }
.ae-tab-list { display: inline-flex; gap: 16rpx; }
.ae-tab { padding: 16rpx 28rpx; border-radius: 999rpx; background: #eef2ff; color: var(--text-secondary); font-size: 26rpx; }
.ae-tab--active { background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%); color: #fff; font-weight: 700; }
.ae-controls { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.ae-control-pill { flex: 1; padding: 24rpx; border-radius: 24rpx; background: #fff7ed; }
.ae-control-pill--timer { background: #ecfeff; }
.ae-control-label { display: block; font-size: 22rpx; color: var(--text-secondary); }
.ae-control-value { display: block; margin-top: 10rpx; font-size: 30rpx; font-weight: 700; color: #0f172a; }
.ae-now { margin-bottom: 20rpx; background: #fff; }
.ae-now-label { display: block; font-size: 22rpx; color: var(--text-secondary); }
.ae-now-head { display: flex; align-items: center; gap: 20rpx; margin-top: 8rpx; }
.ae-now-text { flex: 1; min-width: 0; }
.ae-now-title { display: block; font-size: 30rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ae-now-sub { display: block; margin-top: 6rpx; font-size: 22rpx; color: #2563eb; }
.ae-now-state { width: 68rpx; height: 68rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%); font-size: 30rpx; font-weight: 800; flex-shrink: 0; }
.ae-progress { margin: 22rpx -8rpx 0; }
.ae-time-row { display: flex; justify-content: space-between; margin-top: -4rpx; font-size: 22rpx; color: var(--text-muted); }
.ae-item { display: flex; gap: 20rpx; align-items: center; padding: 24rpx; background: #fff; border-radius: var(--radius-lg); margin-bottom: 16rpx; }
.ae-item--playing { border: 2rpx solid #60a5fa; background: #eff6ff; }
.ae-thumb { width: 84rpx; height: 84rpx; border-radius: 24rpx; background: #e0f2fe; display: flex; align-items: center; justify-content: center; font-size: 40rpx; flex-shrink: 0; }
.ae-info { flex: 1; min-width: 0; }
.ae-title { display: block; font-size: 28rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ae-meta { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--text-muted); }
.ae-type { display: inline-block; margin-top: 10rpx; font-size: 20rpx; color: #0369a1; background: #e0f2fe; padding: 4rpx 12rpx; border-radius: 999rpx; }
.ae-play { width: 54rpx; text-align: center; font-size: 38rpx; color: var(--primary); flex-shrink: 0; }
