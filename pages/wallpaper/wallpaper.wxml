<view class="wp-page">
  <view class="wp-topbar">
    <view>
      <text class="wp-title">屏保壁纸</text>
      <text class="wp-sub">支持从手机相册上传到云端</text>
    </view>
    <button class="btn btn-primary wp-upload" loading="{{uploading}}" bindtap="uploadLocal">上传本地壁纸</button>
  </view>

  <view class="wp-grid">
    <view class="wp-item" wx:for="{{wallpapers}}" wx:key="_id">
      <image class="wp-img" src="{{item.imageUrl}}" mode="aspectFill" bindtap="preview" data-src="{{item.imageUrl}}"/>
      <view class="wp-source" wx:if="{{item.source === 'mine'}}">我的上传</view>
      <view class="wp-actions">
        <button class="wp-btn wp-btn-share" bindtap="shareImage" data-item="{{item}}">分享朋友圈</button>
        <text class="wp-btn" bindtap="save" data-item="{{item}}">保存</text>
        <text class="wp-btn" bindtap="edit" data-item="{{item}}">编辑</text>
        <text class="wp-btn wp-btn-primary" bindtap="useForCheckin" data-item="{{item}}">用于打卡</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{wallpapers.length === 0}}">
    <text class="empty-icon">🖼️</text>
    <text class="empty-text">壁纸加载中...</text>
  </view>

  <canvas class="wp-share-canvas" canvas-id="wallpaperShareCanvas"></canvas>
  <canvas class="wp-save-canvas" canvas-id="wallpaperSaveCanvas"></canvas>

  <view wx:if="{{showPrivacyDialog}}" class="privacy-mask" catchtouchmove="noop">
    <view class="privacy-dialog">
      <text class="privacy-title">保存壁纸图片</text>
      <text class="privacy-desc">保存图片需要使用相册（仅写入）权限。请先阅读并同意{{privacyContractName}}，我们只会写入你主动保存或分享的图片。</text>
      <button class="privacy-contract-btn" bindtap="openPrivacyContract">查看隐私保护指引</button>
      <view class="privacy-actions">
        <button class="privacy-cancel-btn" bindtap="handleRejectPrivacyAuthorization">暂不使用</button>
        <button id="wallpaper-privacy-agree" class="privacy-agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">同意并继续</button>
      </view>
    </view>
  </view>
</view>
