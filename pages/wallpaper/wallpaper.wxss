.wp-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
}

.wp-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 8rpx 4rpx;
}

.wp-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.2;
}

.wp-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.wp-upload {
  white-space: nowrap;
  min-width: 188rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.18);
}

.wp-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 18rpx;
}

.wp-item {
  aspect-ratio: 9 / 15.5;
  position: relative;
  overflow: hidden;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}

.wp-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.wp-source {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.88);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  z-index: 2;
}

.wp-actions {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(15, 23, 42, 0.58);
  backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  z-index: 2;
}

.wp-btn {
  flex: 1;
  min-width: 0;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.14);
}

.wp-btn-share {
  margin: 0;
  padding: 0;
  border: 0;
  background: rgba(37, 99, 235, 0.92);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 14rpx;
  line-height: 54rpx;
}

.wp-btn-share::after {
  border: none;
}

.wp-btn-primary {
  background: rgba(22, 163, 74, 0.92);
}

.empty {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 64rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
}

.wp-share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1080px;
  height: 1080px;
}

.wp-save-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 900px;
  height: 1600px;
}
