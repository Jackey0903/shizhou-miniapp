.sb-page { min-height: 100vh; background: var(--bg-page); padding: 24rpx; padding-bottom: 160rpx; box-sizing: border-box; }
.sb-list { display: flex; flex-direction: column; gap: 20rpx; }
.sb-item { display: flex; gap: 20rpx; background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: 20rpx; position: relative; }
.sb-cover { width: 180rpx; height: 180rpx; border-radius: 20rpx; flex-shrink: 0; background: #e2e8f0; }
.sb-info { flex: 1; min-width: 0; }
.sb-title-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.sb-name { font-size: 30rpx; font-weight: 700; color: var(--text-primary); display: block; }
.sb-progress { font-size: 24rpx; font-weight: 700; color: var(--primary); }
.sb-desc { font-size: 24rpx; color: var(--text-secondary); display: block; margin-top: 10rpx; line-height: 1.6; }
.sb-meta { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-top: 14rpx; }
.sb-meta-item { font-size: 22rpx; color: #475569; }
.sb-plan-meta { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; margin-top: 12rpx; padding: 10rpx 12rpx; background: #eff6ff; border-radius: 8rpx; }
.sb-plan-meta-item { font-size: 21rpx; color: #1d4ed8; }
.sb-plan-date { width: 100%; font-size: 21rpx; color: #475569; }
.sb-progress-bar { width: 100%; height: 12rpx; border-radius: 999rpx; background: #e2e8f0; margin-top: 16rpx; overflow: hidden; }
.sb-progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2563eb 0%, #60a5fa 100%); }
.sb-del { position: absolute; top: 16rpx; right: 16rpx; background: #fee2e2; color: #dc2626; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 100rpx; }
.sb-empty { background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: 64rpx 32rpx; text-align: center; }
.sb-empty-icon { font-size: 72rpx; display: block; }
.sb-empty-title { display: block; margin-top: 18rpx; font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.sb-empty-desc { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--text-secondary); line-height: 1.7; }
