<!--pages/coin-log/coin-log.wxml-->
<view class="coin-page">
  <view class="coin-rule-card">
    <text class="coin-rule-title">舟币获取与消耗</text>
    <text class="coin-rule-text">领取资料按标价消耗舟币；分享打卡海报每次 -10 舟币；完成分享任务每次 +10 舟币，每天最多 +20；完整看完一个广告 +1 舟币。</text>
    <view class="coin-task-list">
      <view class="coin-task-item">
        <view>
          <text class="coin-task-title">分享朋友圈</text>
          <text class="coin-task-desc">每次奖励 10 舟币，今日最多 20 舟币</text>
        </view>
        <button class="coin-task-btn coin-task-btn--orange" bindtap="claimShareReward" loading="{{shareRewarding}}">去分享</button>
      </view>
      <view class="coin-task-item">
        <view>
          <text class="coin-task-title">看广告赚舟币</text>
          <text class="coin-task-desc">完整看完一个激励广告奖励 1 舟币</text>
        </view>
        <button class="coin-task-btn" bindtap="watchAd" loading="{{rewarding}}">去领取</button>
      </view>
    </view>
  </view>

  <view class="coin-empty" wx:if="{{!loading && logs.length === 0}}">
    <text class="coin-empty-icon">🪙</text>
    <text class="coin-empty-text">还没有舟币记录</text>
  </view>

  <view class="coin-list" wx:else>
    <view class="coin-item" wx:for="{{logs}}" wx:key="_id">
      <view class="coin-item-left">
        <text class="coin-item-title">{{item.title}}</text>
        <text class="coin-item-desc">{{item.desc}}</text>
      </view>
      <view class="coin-item-right">
        <text class="coin-item-amount {{item.amount < 0 ? 'coin-item-amount--minus' : ''}}">{{item.amountText}}</text>
        <text class="coin-item-time">{{item.createdAt}}</text>
      </view>
    </view>
  </view>
</view>
