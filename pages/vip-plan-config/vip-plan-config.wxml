<view class="cfg-page">
  <view class="card cfg-form">
    <text class="cfg-title">正式套餐管理</text>
    <text class="cfg-sub">金额、有效期和微信道具ID已锁定，避免修改后导致支付失败。</text>

    <picker range="{{templates}}" range-key="name" value="{{templateIndex}}" bindchange="onTemplateChange">
      <view class="cfg-picker">选择套餐：{{templates[templateIndex].name}}</view>
    </picker>

    <view class="plan-summary">
      <text class="plan-price">¥{{templates[templateIndex].price / 100}}</text>
      <text class="plan-meta">VIP {{templates[templateIndex].days}}天 · 督学 {{templates[templateIndex].supervisionDays}}天</text>
      <text class="plan-meta">支付商品已绑定，金额和有效期不可修改</text>
    </view>

    <textarea class="cfg-textarea" placeholder="权益说明，每行一条" value="{{benefits}}" bindinput="onBenefitsInput"/>
    <button class="btn btn-primary btn-full" bindtap="submit" loading="{{loading}}">保存套餐展示</button>
  </view>

  <view class="cfg-list">
    <view class="cfg-item" wx:for="{{list}}" wx:key="_id">
      <view class="cfg-main">
        <text class="cfg-item-title">{{item.tag}} · {{item.name}}</text>
        <text class="cfg-item-content">¥{{(item.price || 0) / 100}} · VIP {{item.days || 0}}天 · 督学 {{item.supervisionDays || 0}}天</text>
        <text class="cfg-item-content">权益：{{item.benefitText}}</text>
        <text class="cfg-item-meta">{{item.enabled ? '已上线' : '已下线'}}</text>
      </view>
      <button class="cfg-toggle" size="mini" bindtap="toggle" data-id="{{item._id}}" data-enabled="{{item.enabled}}">{{item.enabled ? '下线' : '上线'}}</button>
    </view>
  </view>
</view>
