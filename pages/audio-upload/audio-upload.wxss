.audio-upload-page { min-height: 100vh; background: var(--bg-page); padding: 24rpx; box-sizing: border-box; }
.audio-upload-title { display: block; font-size: 34rpx; font-weight: 800; }
.audio-upload-sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; }
.form-item { margin-top: 24rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 700; margin-bottom: 12rpx; }
.form-picker, .form-input { min-height: 92rpx; border-radius: 24rpx; background: #f8fafc; padding: 0 24rpx; display: flex; align-items: center; font-size: 28rpx; color: #0f172a; box-sizing: border-box; }
.file-list { margin: 24rpx 0; padding: 20rpx 24rpx; border-radius: 24rpx; background: #fff7ed; }
.file-item { font-size: 24rpx; color: #9a3412; line-height: 1.8; }
