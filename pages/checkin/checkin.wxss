.checkin-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f4f6fb 0%, #eef2ff 100%);
  padding: 28rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.checkin-intro {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
  box-shadow: 0 16rpx 40rpx rgba(37, 99, 235, 0.08);
}

.checkin-intro-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #111827;
  letter-spacing: 2rpx;
}

.checkin-intro-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
}

.checkin-card-wrap {
  position: relative;
  min-height: 980rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(37, 99, 235, 0.12);
}

.checkin-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.checkin-overlay {
  position: relative;
  z-index: 1;
  min-height: 980rpx;
  padding: 44rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.12) 0%, rgba(15, 23, 42, 0.58) 100%);
}

.checkin-tag {
  align-self: flex-start;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.checkin-time {
  margin-top: 44rpx;
  font-size: 110rpx;
  line-height: 1;
  font-weight: 300;
  color: #fff;
  letter-spacing: 4rpx;
}

.checkin-date {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
}

.checkin-stats {
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
}

.checkin-stat {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(6rpx);
}

.checkin-stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
}

.checkin-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.checkin-quote-box {
  margin-top: auto;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.15);
}

.checkin-quote {
  font-size: 48rpx;
  line-height: 1.72;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #fff;
  text-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.35);
}

.checkin-share-tip {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(37, 99, 235, 0.08);
}

.checkin-share-title {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 800;
  color: #111827;
}

.checkin-share-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #6b7280;
}

.checkin-share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  border: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.checkin-share-btn::after {
  border: none;
}

.checkin-share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1080px;
  height: 1080px;
}

.privacy-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.58);
}

.privacy-dialog {
  width: 100%;
  max-width: 640rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
}

.privacy-title,
.privacy-desc {
  display: block;
}

.privacy-title {
  color: #111827;
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: 700;
  text-align: center;
}

.privacy-desc {
  margin-top: 20rpx;
  color: #4b5563;
  font-size: 27rpx;
  line-height: 1.7;
}

.privacy-contract-btn {
  margin-top: 12rpx;
  padding: 0;
  color: #2563eb;
  font-size: 27rpx;
  line-height: 64rpx;
  background: transparent;
}

.privacy-contract-btn::after,
.privacy-cancel-btn::after,
.privacy-agree-btn::after {
  border: 0;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.privacy-cancel-btn,
.privacy-agree-btn {
  flex: 1;
  height: 84rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 84rpx;
}

.privacy-cancel-btn {
  color: #374151;
  background: #f3f4f6;
}

.privacy-agree-btn {
  color: #ffffff;
  background: #2563eb;
}
