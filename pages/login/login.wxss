/* pages/login/login.wxss */

.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #EFF6FF 0%, #F5F6FA 40%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
}

.login-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx 60rpx;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(37,99,235,0.2);
}

.login-app-name {
  font-size: 62rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 2rpx;
  font-family: 'MiSans','HarmonyOS Sans SC','PingFang SC',sans-serif;
  margin-bottom: 16rpx;
}

.login-tagline {
  font-size: 32rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  font-family: 'MiSans','HarmonyOS Sans SC','PingFang SC',sans-serif;
}

.login-body {
  padding: 0 32rpx 80rpx;
}

.login-card {
  background: #FFFFFF;
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-md);
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 48rpx;
}

.login-btn {
  margin-bottom: 24rpx !important;
}

.login-phone-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.agreement {
  margin-top: 32rpx;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.agreement-text {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.agreement-link {
  color: var(--primary);
}

.login-skip {
  text-align: center;
  margin-top: 40rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}
