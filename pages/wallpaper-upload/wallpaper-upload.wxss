.wallpaper-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: var(--bg-page);
}

.wallpaper-panel {
  padding: 28rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.wallpaper-title,
.wallpaper-sub,
.wallpaper-name,
.manage-title,
.manage-name,
.manage-meta {
  display: block;
}

.wallpaper-title {
  font-size: 34rpx;
  font-weight: 800;
}

.wallpaper-sub {
  margin: 8rpx 0 22rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
}

.wallpaper-files {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--border);
}

.wallpaper-file,
.manage-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.wallpaper-file {
  min-height: 118rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.wallpaper-preview {
  width: 72rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.wallpaper-file-main,
.manage-main {
  flex: 1;
  min-width: 0;
}

.wallpaper-input {
  min-height: 58rpx;
  padding: 0 12rpx;
  background: #f8fafc;
  border-radius: var(--radius-sm);
  font-size: 25rpx;
}

.wallpaper-name {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wallpaper-remove,
.manage-toggle {
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
}

.wallpaper-remove {
  background: #fef2f2;
  color: var(--danger);
}

.wallpaper-remove::after,
.manage-toggle::after {
  border: 0;
}

.upload-button {
  margin-top: 20rpx;
}

.wallpaper-manage {
  margin-top: 32rpx;
}

.manage-title {
  margin: 0 4rpx 14rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.manage-item {
  min-height: 108rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: var(--radius-md);
}

.manage-image {
  width: 60rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.manage-name {
  font-size: 27rpx;
  font-weight: 700;
}

.manage-meta {
  margin-top: 5rpx;
  color: var(--text-secondary);
  font-size: 21rpx;
}

.manage-toggle {
  min-width: 92rpx;
  background: #eff6ff;
  color: var(--primary);
}
