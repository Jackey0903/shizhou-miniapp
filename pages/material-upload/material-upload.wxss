.upload-page { min-height: 100vh; background: var(--bg-page); padding: 24rpx; box-sizing: border-box; }
.upload-title { display: block; font-size: 34rpx; font-weight: 800; }
.upload-sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; }
.form-item { margin-top: 24rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 700; margin-bottom: 12rpx; }
.form-picker, .form-input, .form-textarea { min-height: 92rpx; border-radius: 24rpx; background: #f8fafc; padding: 0 24rpx; display: flex; align-items: center; font-size: 28rpx; color: #0f172a; box-sizing: border-box; }
.form-textarea { min-height: 180rpx; padding: 24rpx; line-height: 1.7; }
.file-box { margin: 24rpx 0; padding: 20rpx 24rpx; border-radius: 24rpx; background: #eff6ff; }
.file-name { font-size: 24rpx; color: var(--primary); line-height: 1.8; }
.upload-cover-btn { margin-top: 18rpx; }
