/* pages/question/question.wxss */

.question-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 240rpx;
  overflow-x: hidden;
}

.empty {
  min-height: calc(100vh - 200rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 80rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.empty-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* ===== 顶部 ===== */
.q-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
}

.q-back {
  font-size: 56rpx;
  color: var(--text-primary);
  padding: 0 8rpx;
  line-height: 1;
}

.q-title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.q-title {
  font-size: 30rpx;
  font-weight: 700;
}

.q-progress {
  font-size: 22rpx;
  color: var(--text-muted);
}

.q-header-icons {
  display: flex;
  gap: 20rpx;
}

.q-icon {
  font-size: 40rpx;
  padding: 4rpx;
}

/* ===== 进度条 ===== */
.progress-wrap {
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
}

.progress-text {
  font-size: 22rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

/* ===== 题目卡片 ===== */
.q-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: var(--radius-xl);
  overflow: visible;
  box-shadow: var(--shadow);
}

.q-content {
  padding: 40rpx 36rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
  overflow: visible;
}

.q-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.78;
  display: block;
  min-height: 0;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
  user-select: text;
}

.q-image {
  width: 100%;
  margin-top: 24rpx;
  border-radius: var(--radius-md);
}

/* ===== 答案区（填空/图片题）===== */
.q-fill-panel {
  padding: 32rpx 36rpx 36rpx;
}

.q-fill-input {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background: var(--bg-page);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.7;
}

.q-fill-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.q-fill-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.q-fill-btn-primary {
  background: var(--primary);
  color: #fff;
}

.q-fill-btn-secondary {
  background: #fff;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}

.q-fill-btn::after {
  border: none;
}

.q-answer-toggle {
  padding: 36rpx;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.q-answer-hint {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

.q-answer-reveal {
  width: 100%;
}

.q-fill-result {
  padding: 36rpx;
}

.q-fill-status {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.q-fill-status.is-correct {
  background: var(--secondary-light);
  color: var(--secondary);
}

.q-fill-status.is-wrong {
  background: var(--danger-light);
  color: var(--danger);
}

.q-fill-status.is-self {
  background: #EFF6FF;
  color: #2563EB;
}

.q-fill-status-icon {
  font-size: 28rpx;
}

.q-fill-user-answer {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.q-answer-label {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 12rpx;
}

.q-answer-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--secondary);
  line-height: 1.6;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.q-explanation {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
  line-height: 1.7;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.q-explanation-wrap {
  padding: 24rpx 36rpx;
  border-top: 1rpx solid var(--border);
  background: var(--bg-page);
}

/* ===== 选择题选项 ===== */
.choice-options {
  padding: 24rpx 24rpx 32rpx;
}

.choice-option {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--bg-page);
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  position: relative;
}

.choice-option.correct {
  background: var(--secondary-light);
  border-color: var(--secondary);
}

.choice-option.wrong {
  background: var(--danger-light);
  border-color: var(--danger);
}

.option-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  min-width: 40rpx;
}

.option-text {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.6;
}

.option-mark {
  font-size: 36rpx;
  color: var(--secondary);
  font-weight: 700;
}

.wrong-mark {
  color: var(--danger);
}

/* ===== 广告位 ===== */
.ad-banner {
  margin: 0;
  min-height: 100rpx;
  background: var(--bg-page);
}

.q-report-bar {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 24rpx 0;
}

.q-report-btn {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #FFF1F2;
  color: #E11D48;
  border: 2rpx solid #FECDD3;
  font-size: 26rpx;
  font-weight: 600;
}

.q-report-btn::after {
  border: none;
}

/* ===== 底部三按钮 ===== */
.q-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid var(--border);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.08);
}

.q-action-bar.is-submitting {
  opacity: 0.55;
  pointer-events: none;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  gap: 8rpx;
  transition: background 0.15s;
}

.action-btn:active {
  background: var(--bg-page);
}

.action-emoji {
  font-size: 48rpx;
}

.action-label {
  font-size: 24rpx;
  font-weight: 600;
}

.action-none { border-right: 1rpx solid var(--border); }
.action-none .action-label { color: var(--danger); }

.action-maybe { border-right: 1rpx solid var(--border); }
.action-maybe .action-label { color: var(--accent); }

.action-know .action-label { color: var(--secondary); }

/* ===== Loading ===== */
.q-loading {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-dot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 6rpx solid var(--border);
  border-top-color: var(--primary);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
