.mh-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.mh-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mh-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: #fff;
  color: var(--text-secondary);
  font-size: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
}

.mh-tab.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 700;
}

.mh-item {
  padding: 28rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 20rpx;
}

.mh-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.mh-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.mh-tag,
.status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.mh-tag,
.status-approved {
  background: rgba(37, 99, 235, 0.12);
  color: var(--primary);
}

.status-pending {
  background: rgba(245, 158, 11, 0.14);
  color: #b45309;
}

.status-rejected {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
}

.mh-q,
.mh-a,
.mh-note,
.mh-meta,
.mh-meta-name {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.mh-meta,
.mh-meta-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.review-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.mh-fab {
  position: fixed;
  right: 36rpx;
  bottom: 120rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 16rpx 36rpx rgba(37, 99, 235, 0.35);
  z-index: 10;
}

.composer-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.35);
  z-index: 18;
}

.composer {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  max-height: 78vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  z-index: 19;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.16);
}

.composer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.composer-title {
  font-size: 32rpx;
  font-weight: 700;
}

.composer-close {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.composer-input,
.composer-textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
  background: #fff;
}

.composer-input {
  min-height: 92rpx;
}

.composer-textarea {
  min-height: 220rpx;
}
