<view class="code-page">
  <view class="card code-card">
    <text class="code-title">仕舟公考正式小程序码</text>
    <text class="code-status">{{generated ? '已连接线上正式版本' : '尚未生成，请点击下方按钮'}}</text>
    <image wx:if="{{generated}}" class="code-image" src="{{imageUrl}}" mode="aspectFit" bindtap="preview" show-menu-by-longpress/>
    <view wx:else class="code-empty">生成后可在这里预览、长按或保存正式小程序码</view>
    <view class="code-actions">
      <button class="btn btn-primary code-button" loading="{{generating}}" bindtap="generate">{{generated ? '重新生成' : '生成正式码'}}</button>
      <button wx:if="{{generated}}" class="btn btn-outline code-button" loading="{{saving}}" bindtap="save">保存到相册</button>
    </view>
  </view>

  <view wx:if="{{showPrivacyDialog}}" class="privacy-mask" catchtouchmove="noop">
    <view class="privacy-dialog">
      <text class="privacy-title">保存正式小程序码</text>
      <text class="privacy-desc">保存图片需要使用相册（仅写入）权限。请先阅读并同意{{privacyContractName}}，我们只会写入你主动保存的小程序码。</text>
      <button class="privacy-contract-btn" bindtap="openPrivacyContract">查看隐私保护指引</button>
      <view class="privacy-actions">
        <button class="privacy-cancel-btn" bindtap="handleRejectPrivacyAuthorization">暂不使用</button>
        <button id="miniapp-code-privacy-agree" class="privacy-agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">同意并继续</button>
      </view>
    </view>
  </view>
</view>
