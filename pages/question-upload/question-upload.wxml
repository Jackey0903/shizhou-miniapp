<view class="qu-page">
  <view class="card empty" wx:if="{{loading}}">
    <text class="empty-text">加载中...</text>
  </view>

  <view class="card empty" wx:elif="{{!hasAccess}}">
    <text class="empty-icon">🔒</text>
    <text class="empty-text">当前账号没有录题权限，请在 users 集合中给该账号加上 isAdmin: true。</text>
  </view>

  <view wx:else>
    <view class="qu-card card">
      <view class="qu-head">
        <text class="qu-title">CSV 批量导入</text>
        <text class="qu-sub">固定 CSV UTF-8 模板，不需要题库 ID。</text>
      </view>

      <view class="qu-step-list">
        <view class="qu-step"><text class="qu-step-no">1</text><text>发送模板并填题</text></view>
        <view class="qu-step"><text class="qu-step-no">2</text><text>选择 CSV 校验预览</text></view>
        <view class="qu-step"><text class="qu-step-no">3</text><text>确认后分批导入</text></view>
      </view>

      <view class="qu-template-actions">
        <button class="btn btn-outline qu-template-btn" bindtap="shareCsvTemplate">发送 CSV 模板</button>
        <button class="btn btn-outline qu-template-btn" bindtap="showCsvHelp">格式说明</button>
      </view>
      <button class="btn btn-secondary btn-full" bindtap="chooseCsvFile">选择 CSV 文件</button>

      <view class="qu-import-box" wx:if="{{importSummary}}">
        <text class="qu-import-title">{{importFileName}}</text>
        <view class="qu-import-stats">
          <text>有效 {{importSummary.validCount}}</text>
          <text class="qu-import-error-count" wx:if="{{importSummary.errorCount}}">错误 {{importSummary.errorCount}}</text>
          <text wx:else>校验通过</text>
        </view>
        <text class="qu-import-meta">选择题 {{importSummary.choiceCount}} 题，填空题 {{importSummary.fillCount}} 题</text>
        <text class="qu-import-meta" wx:if="{{importSummary.imported !== undefined}}">已处理 {{importSummary.imported}} / {{importSummary.validCount}}</text>

        <view class="qu-error-list" wx:if="{{importErrors.length}}">
          <text class="qu-error-title">请修正以下错误后重新选择文件</text>
          <text class="qu-error-item" wx:for="{{importErrors}}" wx:key="*this">{{item}}</text>
          <text class="qu-error-more" wx:if="{{importSummary.errorCount > importErrors.length}}">错误较多，仅显示前 {{importErrors.length}} 条</text>
        </view>

        <view class="qu-preview" wx:if="{{previewQuestions.length}}">
          <text class="qu-preview-title">前 {{previewQuestions.length}} 题预览</text>
          <view class="qu-preview-item" wx:for="{{previewQuestions}}" wx:key="rowNumber">
            <view class="qu-preview-head">
              <text>第 {{item.rowNumber}} 行 · {{item.location}}</text>
              <text>{{item.typeLabel}} · 答案 {{item.answer}}</text>
            </view>
            <text class="qu-preview-content">{{item.content}}</text>
          </view>
        </view>

        <view class="qu-import-actions">
          <button class="btn btn-primary qu-import-btn" disabled="{{importErrors.length > 0}}" loading="{{importing}}" bindtap="importQuestionsFromFile">确认导入</button>
          <button class="btn btn-outline qu-import-btn" bindtap="clearImportFile">清空文件</button>
        </view>
      </view>
    </view>

    <view class="qu-card card">
      <view class="qu-head">
        <text class="qu-title">手工录题</text>
        <text class="qu-sub">当前录入序号：{{nextSort}}</text>
      </view>

      <view class="qu-field">
        <text class="qu-label">课程</text>
        <picker mode="selector" range="{{courseNames}}" value="{{form.courseIndex}}" bindchange="onCourseChange">
          <view class="qu-picker">{{courseNames[form.courseIndex] || '请选择课程'}}</view>
        </picker>
      </view>

      <view class="qu-field">
        <text class="qu-label">题型</text>
        <picker mode="selector" range="{{questionTypes}}" value="{{form.typeIndex}}" bindchange="onTypeChange">
          <view class="qu-picker">{{questionTypes[form.typeIndex]}}</view>
        </picker>
      </view>

      <view class="qu-field">
        <text class="qu-label">题干</text>
        <textarea class="qu-textarea" placeholder="请输入题目内容" value="{{form.content}}" data-field="content" bindinput="onInput" maxlength="500" auto-height></textarea>
      </view>

      <block wx:if="{{form.typeIndex === 0}}">
        <view class="qu-field">
          <text class="qu-label">选项 A</text>
          <input class="qu-input" placeholder="请输入选项 A" value="{{form.optionA}}" data-field="optionA" bindinput="onInput"/>
        </view>
        <view class="qu-field">
          <text class="qu-label">选项 B</text>
          <input class="qu-input" placeholder="请输入选项 B" value="{{form.optionB}}" data-field="optionB" bindinput="onInput"/>
        </view>
        <view class="qu-field">
          <text class="qu-label">选项 C</text>
          <input class="qu-input" placeholder="请输入选项 C" value="{{form.optionC}}" data-field="optionC" bindinput="onInput"/>
        </view>
        <view class="qu-field">
          <text class="qu-label">选项 D</text>
          <input class="qu-input" placeholder="请输入选项 D" value="{{form.optionD}}" data-field="optionD" bindinput="onInput"/>
        </view>
        <view class="qu-field">
          <text class="qu-label">正确答案</text>
          <picker mode="selector" range="{{answerOptions}}" value="{{form.correctIndex}}" bindchange="onCorrectIndexChange">
            <view class="qu-picker">{{answerOptions[form.correctIndex]}}</view>
          </picker>
        </view>
      </block>

      <view class="qu-field" wx:else>
        <text class="qu-label">答案</text>
        <input class="qu-input" placeholder="请输入填空题答案" value="{{form.answer}}" data-field="answer" bindinput="onInput"/>
      </view>

      <view class="qu-field">
        <text class="qu-label">解析（可选）</text>
        <textarea class="qu-textarea" placeholder="可不填" value="{{form.explanation}}" data-field="explanation" bindinput="onInput" maxlength="500" auto-height></textarea>
      </view>

      <button class="btn btn-primary btn-full" loading="{{saving}}" bindtap="submitQuestion">提交题目</button>
    </view>
  </view>
</view>
