.qu-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  box-sizing: border-box;
}

.qu-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.qu-head {
  margin-bottom: 24rpx;
}

.qu-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.qu-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.qu-step-list {
  margin-bottom: 22rpx;
  border-top: 2rpx solid var(--border);
}

.qu-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 76rpx;
  border-bottom: 2rpx solid var(--border);
  color: var(--text-primary);
  font-size: 26rpx;
}

.qu-step-no {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex: 0 0 40rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.qu-template-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.qu-template-btn {
  flex: 1;
  min-width: 0;
  min-height: 84rpx;
  padding: 16rpx 12rpx;
  font-size: 25rpx;
  line-height: 1.35;
  white-space: normal;
}

.qu-field {
  margin-bottom: 22rpx;
}

.qu-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.qu-input,
.qu-textarea,
.qu-picker {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  background: #fff;
  min-height: 96rpx;
  padding: 24rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.qu-textarea {
  min-height: 220rpx;
}

.qu-import-box {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: #F8FAFC;
  border: 2rpx dashed #CBD5E1;
}

.qu-import-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  word-break: break-all;
}

.qu-import-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.qu-import-stats {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #166534;
}

.qu-import-error-count {
  color: #B42318;
}

.qu-error-list {
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-top: 2rpx solid #FECACA;
  border-bottom: 2rpx solid #FECACA;
}

.qu-error-title,
.qu-error-item,
.qu-error-more {
  display: block;
  color: #B42318;
  font-size: 24rpx;
  line-height: 1.6;
}

.qu-error-title {
  margin-bottom: 8rpx;
  font-weight: 700;
}

.qu-error-more {
  margin-top: 10rpx;
  color: var(--text-secondary);
}

.qu-preview {
  margin-top: 22rpx;
  border-top: 2rpx solid var(--border);
}

.qu-preview-title {
  display: block;
  padding: 18rpx 0 10rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.qu-preview-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.qu-preview-head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.qu-preview-head text {
  min-width: 0;
  overflow-wrap: anywhere;
}

.qu-preview-content {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.qu-import-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.qu-import-btn {
  flex: 1;
}
