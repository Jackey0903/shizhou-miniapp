<view class="order-page">
  <view class="order-header">
    <text class="order-title">我的订单</text>
    <text class="order-sub">展示会员与督学服务的小程序虚拟支付订单，支付状态以平台记录为准。</text>
  </view>

  <view class="order-empty" wx:if="{{!loading && orders.length === 0}}">
    <text class="order-empty-icon">🧾</text>
    <text class="order-empty-text">暂无订单</text>
  </view>

  <view class="order-list" wx:else>
    <view class="order-card" wx:for="{{orders}}" wx:key="orderId">
      <view class="order-card-head">
        <view>
          <text class="order-name">{{item.planLabel || '会员服务订单'}}</text>
          <text class="order-no">订单号：{{item.outTradeNo}}</text>
        </view>
        <text class="order-status order-status--{{item.status}}">{{item.statusLabel}}</text>
      </view>
      <view class="order-row">
        <text class="order-label">支付方式</text>
        <text class="order-value">小程序虚拟支付</text>
      </view>
      <view class="order-row">
        <text class="order-label">订单金额</text>
        <text class="order-price">{{item.priceText}}</text>
      </view>
      <view class="order-row">
        <text class="order-label">创建时间</text>
        <text class="order-value">{{item.createdAtText || '-'}}</text>
      </view>
      <view class="order-row" wx:if="{{item.payTimeText}}">
        <text class="order-label">支付时间</text>
        <text class="order-value">{{item.payTimeText}}</text>
      </view>
      <view class="order-row" wx:if="{{item.deliveryLabel}}">
        <text class="order-label">权益状态</text>
        <text class="order-value">{{item.deliveryLabel}}</text>
      </view>
      <view class="order-row" wx:if="{{item.vipExpireText}}">
        <text class="order-label">权益有效期</text>
        <text class="order-value">{{item.vipExpireText}}</text>
      </view>
    </view>
  </view>
</view>
